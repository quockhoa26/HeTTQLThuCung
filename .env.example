# =========================================================
# Pet Management System - Environment Variables Template
# =========================================================

# Application Ports (Host bindings)
NGINX_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
PGADMIN_PORT=5050
LOKI_PORT=3100

# Backend Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=change-this-to-a-very-secure-random-key-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=petadmin
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=petmanagement

# pgAdmin 4 Administration Tool
PGADMIN_DEFAULT_EMAIL=admin@petcare.vn
PGADMIN_DEFAULT_PASSWORD=replace-with-your-local-pgadmin-password
